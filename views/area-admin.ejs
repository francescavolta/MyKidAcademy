<%- include('partials/testa') %>

<h1 style="margin-top:2rem">Coordinamento</h1>
<p class="guida">Tutto quello che passa dal sito: candidature da approvare, ragazze attive, richieste dei genitori.</p>

<ul class="scorciatoie">
  <li><a class="bottone chiaro" href="/area/coordinamento/agenda">Agenda della settimana</a></li>
  <li><a class="bottone chiaro" href="/area/coordinamento/messaggi">Messaggi<% if (messaggiNuovi) { %> · <%= messaggiNuovi %><% } %></a></li>
  <li><a class="bottone chiaro" href="/area/coordinamento/home">Home</a></li>
  <li><a class="bottone chiaro" href="/area/coordinamento/blog">Blog</a></li>
  <li><a class="bottone chiaro" href="/area/coordinamento/pagine">Pagine</a></li>
  <li><a class="bottone chiaro" href="/area/coordinamento/immagini">Immagini</a></li>
  <li><a class="bottone chiaro" href="/area/coordinamento/aspetto">Aspetto del sito</a></li>
</ul>

<ul class="sommario">
  <li><b><%= inAttesa.length %></b> candidature da vedere</li>
  <li><b><%= attive.length %></b> ragazze attive</li>
  <li><b><%= richieste.filter(function (r) { return r.stato === 'nuova'; }).length %></b> richieste nuove</li>
  <li><b><%= refAttesa.length %></b> referenze da approvare</li>
  <li><b><%= messaggiNuovi %></b> conversazioni da leggere</li>
</ul>

<section>
  <h2>Candidature in attesa</h2>
  <% if (inAttesa.length === 0) { %>
    <div class="vuoto"><p>Nessuna candidatura in sospeso. Quando qualcuno si registra da “Lavora con noi” compare qui.</p></div>
  <% } else { %>
    <div class="tabella-avvolgi">
      <table>
        <thead>
          <tr><th>Nome</th><th>Email</th><th>Zona</th><th>Mansioni</th><th>Tariffa</th><th>Azioni</th></tr>
        </thead>
        <tbody>
          <% inAttesa.forEach(function (t) { %>
            <tr>
              <td><a href="/area/coordinamento/tutor/<%= t.id %>"><%= t.nome %></a></td>
              <td><%= t.email %><% if (t.telefono) { %><br><span class="zona"><%= t.telefono %></span><% } %></td>
              <td><%= t.zona || '—' %></td>
              <td><%= t.mansioni.map(labelMansione).join(', ') || '—' %></td>
              <td><%= tariffaTesto(t) || '—' %></td>
              <td>
                <div class="riga-azioni">
                  <form method="post" action="/area/coordinamento/tutor/<%= t.id %>/stato">
                    <input type="hidden" name="stato" value="approvato">
                    <button class="bottone piccolo" type="submit">Approva</button>
                  </form>
                  <form method="post" action="/area/coordinamento/tutor/<%= t.id %>/stato">
                    <input type="hidden" name="stato" value="rifiutato">
                    <button class="bottone piccolo chiaro" type="submit">Rifiuta</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section>
  <h2>Ragazze attive</h2>
  <% if (attive.length === 0) { %>
    <div class="vuoto"><p>Nessuna scheda pubblica per ora. Approva una candidatura e comparirà sul sito.</p></div>
  <% } else { %>
    <div class="tabella-avvolgi">
      <table>
        <thead>
          <tr><th>Nome</th><th>Contatti</th><th>Mansioni</th><th>Materie</th><th>Tariffa</th><th>Azioni</th></tr>
        </thead>
        <tbody>
          <% attive.forEach(function (t) { %>
            <tr>
              <td><a href="/area/coordinamento/tutor/<%= t.id %>"><%= t.nome %></a><br><span class="zona"><%= t.zona || '' %></span></td>
              <td><%= t.email %><% if (t.telefono) { %><br><span class="zona"><%= t.telefono %></span><% } %></td>
              <td><%= t.mansioni.map(labelMansione).join(', ') || '—' %></td>
              <td><%= t.materie.join(', ') || '—' %></td>
              <td><%= tariffaTesto(t) || '—' %></td>
              <td>
                <div class="riga-azioni">
                  <a class="bottone piccolo chiaro" href="/area/coordinamento/tutor/<%= t.id %>">Apri scheda</a>
                  <form method="post" action="/area/coordinamento/tutor/<%= t.id %>/stato">
                    <input type="hidden" name="stato" value="sospeso">
                    <button class="bottone piccolo chiaro" type="submit">Sospendi</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<% if (refAttesa.length) { %>
<section>
  <h2>Referenze da approvare</h2>
  <p class="guida">Le hanno scritte le famiglie dalla pagina della ragazza. Finché non le pubblichi non si vedono.</p>
  <ul class="agenda">
    <% refAttesa.forEach(function (r) { %>
      <li class="giorno">
        <h3><%= r.tutor_nome %> · <span class="stelle"><%= stelline(r.stelle) %></span></h3>
        <p class="testo" style="margin:.2rem 0"><%= r.commento %></p>
        <div class="data"><%= r.autore %><% if (r.email) { %> · <%= r.email %><% } %> · <%= new Date(r.created_at).toLocaleDateString('it-IT') %></div>
        <div class="riga-azioni" style="margin-top:.6rem">
          <form method="post" action="/area/coordinamento/referenze/<%= r.id %>/pubblica">
            <button class="bottone piccolo" type="submit">Pubblica</button>
          </form>
          <form method="post" action="/area/coordinamento/referenze/<%= r.id %>/elimina"
                onsubmit="return confirm('Eliminare questa referenza?')">
            <button class="bottone piccolo chiaro" type="submit">Elimina</button>
          </form>
          <a class="bottone piccolo chiaro" href="/area/coordinamento/tutor/<%= r.tutor_id %>">Apri la scheda</a>
        </div>
      </li>
    <% }) %>
  </ul>
</section>
<% } %>

<section>
  <h2>Richieste dei genitori</h2>
  <% if (richieste.length === 0) { %>
    <div class="vuoto"><p>Nessuna richiesta ancora. Arrivano dalle pagine delle ragazze.</p></div>
  <% } else { %>
    <div class="tabella-avvolgi">
      <table>
        <thead>
          <tr><th>Arrivata</th><th>Genitore</th><th>Per</th><th>Tutor</th><th>Fascia</th><th>Stato</th><th>Chat</th></tr>
        </thead>
        <tbody>
          <% richieste.forEach(function (r) { %>
            <tr>
              <td><%= new Date(r.created_at).toLocaleDateString('it-IT') %></td>
              <td><%= r.genitore_nome %><br><span class="zona"><%= r.genitore_email %><% if (r.genitore_telefono) { %> · <%= r.genitore_telefono %><% } %></span>
                <% if (r.messaggio) { %><br><span class="nota"><%= r.messaggio %></span><% } %></td>
              <td><%= labelMansione(r.mansione) %></td>
              <td><%= r.tutor_nome || '—' %></td>
              <td>
                <% if (r.quando) { %><div class="data"><%= r.quando %></div><% } %>
                <% var mie = fasceLibere.filter(function (f) { return f.user_id === r.tutor_id; }); %>
                <% if (r.tutor_id && (mie.length || r.disponibilita_id)) { %>
                  <form method="post" action="/area/coordinamento/richieste/<%= r.id %>/fascia">
                    <select name="disponibilita_id" onchange="this.form.submit()" aria-label="Fascia per <%= r.genitore_nome %>">
                      <option value="">nessuna fascia</option>
                      <% if (r.disponibilita_id && !mie.some(function (f) { return f.id === r.disponibilita_id; })) { %>
                        <option value="<%= r.disponibilita_id %>" selected>fascia già scelta</option>
                      <% } %>
                      <% mie.forEach(function (f) { %>
                        <option value="<%= f.id %>" <%- r.disponibilita_id === f.id ? 'selected' : '' %>>
                          <%= new Date(f.data).toLocaleDateString('it-IT', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }) %> <%= ora(f.ora_inizio) %>
                        </option>
                      <% }) %>
                    </select>
                    <noscript><button class="bottone piccolo chiaro" type="submit">Collega</button></noscript>
                  </form>
                <% } else { %>—<% } %>
              </td>
              <td>
                <form method="post" action="/area/coordinamento/richieste/<%= r.id %>/stato">
                  <select name="stato" onchange="this.form.submit()">
                    <% STATI_RICHIESTA.forEach(function (s) { %>
                      <option value="<%= s %>" <%- r.stato === s ? 'selected' : '' %>><%= s.replace('_', ' ') %></option>
                    <% }) %>
                  </select>
                  <noscript><button class="bottone piccolo chiaro" type="submit">Salva</button></noscript>
                </form>
              </td>
              <td>
                <% if (r.conversazione_id) { %>
                  <a class="bottone piccolo chiaro" href="/area/coordinamento/messaggi/<%= r.conversazione_id %>">Apri</a>
                <% } else if (r.tutor_id) { %>
                  <form method="post" action="/area/coordinamento/richieste/<%= r.id %>/conversazione">
                    <button class="bottone piccolo chiaro" type="submit">Crea</button>
                  </form>
                <% } else { %>
                  <span class="data">—</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<% if (altre.length) { %>
<section>
  <h2>Rifiutate e sospese</h2>
  <div class="tabella-avvolgi">
    <table>
      <thead><tr><th>Nome</th><th>Email</th><th>Stato</th><th>Azioni</th></tr></thead>
      <tbody>
        <% altre.forEach(function (t) { %>
          <tr>
            <td><%= t.nome %></td>
            <td><%= t.email %></td>
            <td><span class="stato stato--<%= t.status %>"><%= t.status %></span></td>
            <td>
              <form method="post" action="/area/coordinamento/tutor/<%= t.id %>/stato">
                <input type="hidden" name="stato" value="approvato">
                <button class="bottone piccolo chiaro" type="submit">Riattiva</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<section>
  <h2>Impostazioni dell'account</h2>
  <div class="due-colonne">
    <div>
      <h3>Un secondo accesso al coordinamento</h3>
      <p class="testo">Se qualcuno ti aiuta a gestire l'agenzia, dagli un accesso suo invece di condividere il tuo. Vede e può fare tutto quello che fai tu.</p>
      <form class="modulo" method="post" action="/area/coordinamento/coordinatori">
        <div class="doppia">
          <div>
            <label for="co_nome">Nome</label>
            <input id="co_nome" name="nome" type="text">
          </div>
          <div>
            <label for="co_email">Email</label>
            <input id="co_email" name="email" type="email" required>
          </div>
        </div>
        <div>
          <label for="co_password">Password da darle <span class="aiuto">Almeno 8 caratteri. Potrà cambiarla dal link "password dimenticata".</span></label>
          <input id="co_password" name="password" type="password" minlength="8" required>
        </div>
        <div><button class="bottone" type="submit">Crea l'accesso</button></div>
      </form>
    </div>
    <div>
      <h3>Copia dei dati</h3>
      <p class="testo">Scarica tutto quello che c'è nel sito in un unico file: candidature, richieste, referenze, articoli, pagine e impostazioni. Le foto no, quelle sono nel database e pesano troppo per questo file.</p>
      <p class="testo">Fallo ogni tanto e tienilo da parte: è la tua rete di sicurezza se il database viene cancellato.</p>
      <p><a class="bottone chiaro" href="/area/coordinamento/esporta.json">Scarica la copia</a></p>
    </div>
  </div>
</section>

<%- include('partials/piede') %>
