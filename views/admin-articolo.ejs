<%- include('partials/testa') %>

<p style="margin-top:1.5rem"><a href="/area/coordinamento/blog">← Blog</a></p>
<h1><%= a.id ? 'Modifica articolo' : 'Nuovo articolo' %></h1>

<form class="modulo larga" method="post" action="<%= a.id ? '/area/coordinamento/blog/' + a.id : '/area/coordinamento/blog' %>" style="max-width:44rem">
  <div>
    <label for="titolo">Titolo</label>
    <input id="titolo" name="titolo" type="text" required value="<%= a.titolo %>">
  </div>
  <div>
    <label for="sommario">Sommario
      <span class="aiuto">Una o due righe: è quello che si legge nell'elenco del blog.</span>
    </label>
    <input id="sommario" name="sommario" type="text" maxlength="300" value="<%= a.sommario %>">
  </div>
  <div>
    <label for="corpo">Articolo
      <span class="aiuto">Scrivi normale e usa i bottoni qui sotto. Sono scorciatoie: mettono dei segni nel testo (<code>##</code>, <code>**</code>) che diventano titoli e grassetto nella pagina vera.</span>
    </label>

    <div id="barra-strumenti" class="strumenti">
      <button type="button" data-azione="h2" title="Sottotitolo">Titolo</button>
      <button type="button" data-azione="h3" title="Sottotitolo piccolo">Titolo piccolo</button>
      <button type="button" data-azione="grassetto"><strong>G</strong></button>
      <button type="button" data-azione="corsivo"><em>C</em></button>
      <button type="button" data-azione="lista">Elenco</button>
      <button type="button" data-azione="link">Link</button>
      <span class="divisore"></span>
      <select id="scegli-immagine" aria-label="Immagine da inserire">
        <option value="">scegli un'immagine…</option>
        <% immagini.forEach(function (i) { %><option value="<%= i.id %>"><%= i.nome %></option><% }) %>
      </select>
      <button type="button" data-azione="immagine">Inserisci</button>
    </div>

    <textarea id="corpo" name="corpo" style="min-height:20rem"><%= a.corpo %></textarea>
  </div>

  <div>
    <label>Anteprima <span class="aiuto">Così verrà la pagina.</span></label>
    <div id="anteprima" class="anteprima testo-lungo"></div>
  </div>

  <div>
    <label for="immagine_id">Immagine di copertina
      <span class="aiuto">Si carica da <a href="/area/coordinamento/immagini">Immagini</a>.</span>
    </label>
    <select id="immagine_id" name="immagine_id">
      <option value="">Nessuna</option>
      <% immagini.forEach(function (i) { %>
        <option value="<%= i.id %>" <%- String(a.immagine_id) === String(i.id) ? 'selected' : '' %>><%= i.nome %></option>
      <% }) %>
    </select>
    <% if (a.immagine_id) { %>
      <img class="copertina copertina--piccola" src="/immagini/<%= a.immagine_id %>" alt="">
    <% } %>
  </div>
  <div>
    <label for="slug">Indirizzo della pagina
      <span class="aiuto">Lascia vuoto e lo genero dal titolo.</span>
    </label>
    <input id="slug" name="slug" type="text" value="<%= a.slug %>" placeholder="come-scegliere-una-babysitter">
  </div>
  <fieldset>
    <legend>Visibilità</legend>
    <div class="caselle">
      <label><input type="radio" name="pubblicato" value="no" <%- a.pubblicato ? '' : 'checked' %>> Bozza, la vedo solo io</label>
      <label><input type="radio" name="pubblicato" value="si" <%- a.pubblicato ? 'checked' : '' %>> Online, visibile a tutti</label>
    </div>
  </fieldset>
  <div class="riga-azioni">
    <button class="bottone" type="submit">Salva</button>
    <% if (a.id) { %><a class="bottone chiaro" href="/blog/<%= a.slug %>">Guarda la pagina</a><% } %>
  </div>
</form>

<% if (a.id) { %>
  <form method="post" action="/area/coordinamento/blog/<%= a.id %>/elimina" style="margin-top:2.5rem"
        onsubmit="return confirm('Eliminare definitivamente questo articolo?')">
    <button class="link-testo" type="submit">Elimina questo articolo</button>
  </form>
<% } %>

<script src="/editor.js" defer></script>

<%- include('partials/piede') %>
