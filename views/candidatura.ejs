<%- include('partials/testa') %>

<h1 style="margin-top:2rem">Lavora con noi</h1>
<p class="guida">Compila la tua scheda. La leggiamo, ti contattiamo e quando ti approviamo la tua pagina diventa visibile ai genitori.</p>

<form class="modulo larga" method="post" action="/lavora-con-noi" style="margin-top:1.8rem;max-width:44rem">
  <div class="doppia">
    <div>
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required>
    </div>
    <div>
      <label for="password">Password
        <span class="aiuto">Almeno 8 caratteri. Ti servirà per entrare nella tua pagina.</span>
      </label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required>
    </div>
  </div>

  <% var t = { nome:'', telefono:'', zona:'', tariffa:null, tariffa_max:null, bio:'', mansioni:[], materie:[] }; %>
  <%- include('partials/campi-tutor', { t: t }) %>

  <%- include('partials/consenso') %>
  <div><button class="bottone" type="submit">Manda la candidatura</button></div>
</form>

<%- include('partials/piede') %>
