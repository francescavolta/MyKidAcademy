<%- include('partials/testa') %>

<p style="margin-top:1.5rem"><a href="/area/coordinamento">← Coordinamento</a></p>
<h1>Home</h1>
<p class="guida">La home è fatta di blocchi, uno sotto l'altro. Qui li sposti, li spegni, ne aggiungi e ne togli. Il titolo grande e l'immagine in cima si cambiano invece da <a href="/area/coordinamento/aspetto">Aspetto del sito</a>.</p>

<% if (sezioni.length === 0) { %>
  <div class="vuoto"><p>Nessun blocco: la home mostra solo il titolo in cima. Aggiungine uno qui sotto.</p></div>
<% } else { %>
  <ul class="blocchi">
    <% sezioni.forEach(function (s, i) { %>
      <li class="<%= s.attiva ? '' : 'blocchi--spento' %>">
        <div class="blocchi-testa">
          <div>
            <h3><%= s.titolo || TIPI_SEZIONE[s.tipo].nome %></h3>
            <span class="data"><%= TIPI_SEZIONE[s.tipo].nome %><% if (s.larghezza === 'meta') { %> · metà larghezza<% } %> ·
              <span class="stato <%= s.attiva ? 'stato--approvato' : 'stato--in_attesa' %>"><%= s.attiva ? 'visibile' : 'spento' %></span>
            </span>
          </div>
          <div class="riga-azioni">
            <form method="post" action="/area/coordinamento/home/<%= s.id %>/sposta">
              <input type="hidden" name="verso" value="su">
              <button class="bottone piccolo chiaro" type="submit" <%- i === 0 ? 'disabled' : '' %> title="Sposta su">↑</button>
            </form>
            <form method="post" action="/area/coordinamento/home/<%= s.id %>/sposta">
              <input type="hidden" name="verso" value="giu">
              <button class="bottone piccolo chiaro" type="submit" <%- i === sezioni.length - 1 ? 'disabled' : '' %> title="Sposta giù">↓</button>
            </form>
            <form method="post" action="/area/coordinamento/home/<%= s.id %>/accendi">
              <button class="bottone piccolo chiaro" type="submit"><%= s.attiva ? 'Spegni' : 'Accendi' %></button>
            </form>
            <a class="bottone piccolo chiaro" href="/area/coordinamento/home/<%= s.id %>">Modifica</a>
          </div>
        </div>
        <% if (s.corpo) { %><p class="testo"><%= s.corpo.length > 150 ? s.corpo.slice(0, 150) + '…' : s.corpo %></p><% } %>
      </li>
    <% }) %>
  </ul>
<% } %>

<h2 style="margin-top:2.5rem">Aggiungi un blocco</h2>
<form class="modulo" method="post" action="/area/coordinamento/home/aggiungi">
  <div>
    <label for="tipo">Che tipo</label>
    <select id="tipo" name="tipo">
      <% Object.keys(TIPI_SEZIONE).forEach(function (k) { %>
        <option value="<%= k %>"><%= TIPI_SEZIONE[k].nome %> — <%= TIPI_SEZIONE[k].spiega %></option>
      <% }) %>
    </select>
  </div>
  <div><button class="bottone" type="submit">Aggiungi in fondo</button></div>
</form>

<p style="margin-top:2rem"><a class="bottone chiaro" href="/" target="_blank" rel="noopener">Apri la home</a></p>

<%- include('partials/piede') %>
