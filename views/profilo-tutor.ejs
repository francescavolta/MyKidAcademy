<%- include('partials/testa') %>

<div class="due-colonne" style="margin-top:2rem">
  <div>
    <div class="scheda-testa">
      <%- include('partials/faccia', { t: t }) %>
      <div>
        <h1 style="font-size:2.1rem;margin:0"><%= t.nome %></h1>
        <% if (t.zona) { %><div class="zona"><%= t.zona %></div><% } %>
      </div>
    </div>

    <% if (t.bio) { %><p style="margin-top:1.2rem"><%= t.bio %></p><% } %>

    <% if (t.mansioni.length) { %>
      <h3>Di cosa si occupa</h3>
      <ul class="etichette"><% t.mansioni.forEach(function (m) { %><li><%= labelMansione(m) %></li><% }) %></ul>
    <% } %>

    <% if (t.materie.length) { %>
      <h3 style="margin-top:1.3rem">Materie</h3>
      <ul class="etichette"><% t.materie.forEach(function (m) { %><li><%= m %></li><% }) %></ul>
    <% } %>

    <% if (tariffaTesto(t)) { %>
      <p class="tariffa" style="font-size:1.25rem;margin-top:1.3rem"><%= tariffaTesto(t) %></p>
    <% } %>
    <% if (t.referenze_n > 0) { %>
      <p style="margin:0"><span class="stelle"><%= stelline(t.stelle_media) %></span> <span class="data"><%= Number(t.stelle_media) %> su 5 · <%= t.referenze_n %> referenze</span></p>
    <% } %>

    <span id="referenze"></span>
    <%- include('partials/referenze', { referenze: referenze, gestisci: false }) %>

    <details class="lascia-referenza">
      <summary>Hai già lavorato con <%= t.nome.split(' ')[0] %>? Lascia una referenza</summary>
      <p class="testo">La leggiamo noi e poi la pubblichiamo su questa pagina. Non pubblichiamo la tua email.</p>
      <form class="modulo" method="post" action="/tutor/<%= t.id %>/referenza">
        <div class="doppia">
          <div>
            <label for="autore">Come ti firmi <span class="aiuto">Es. "Anna, mamma di Luca".</span></label>
            <input id="autore" name="autore" type="text" maxlength="120" required>
          </div>
          <div>
            <label for="stelle">Quante stelle</label>
            <select id="stelle" name="stelle">
              <option value="5">★★★★★ — 5</option>
              <option value="4">★★★★☆ — 4</option>
              <option value="3">★★★☆☆ — 3</option>
              <option value="2">★★☆☆☆ — 2</option>
              <option value="1">★☆☆☆☆ — 1</option>
            </select>
          </div>
        </div>
        <div>
          <label for="email">La tua email <span class="aiuto">Solo per poterti contattare se serve. Facoltativa.</span></label>
          <input id="email" name="email" type="email">
        </div>
        <div>
          <label for="commento">Com'è andata</label>
          <textarea id="commento" name="commento" minlength="15" maxlength="800" required></textarea>
        </div>
        <%- include('partials/consenso') %>
        <div><button class="bottone" type="submit">Invia la referenza</button></div>
      </form>
    </details>

    <h3 style="margin-top:1.8rem">Quando è libera</h3>
    <% if (giorni.length === 0) { %>
      <div class="vuoto"><p>Nessuna fascia pubblicata in questo momento. Mandaci la richiesta qui accanto e ti diciamo noi quando può.</p></div>
    <% } else { %>
      <ul class="agenda">
        <% giorni.forEach(function (g) { %>
          <li class="giorno">
            <h3><%= dataIt(g.data) %></h3>
            <% g.slots.forEach(function (s) { %>
              <div class="fascia">
                <span class="orario"><%= ora(s.ora_inizio) %> – <%= ora(s.ora_fine) %></span>
                <% if (s.nota) { %><span class="nota"><%= s.nota %></span><% } %>
              </div>
            <% }) %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div>
    <div class="scheda">
      <h2 style="font-size:1.4rem">Richiedi <%= t.nome.split(' ')[0] %></h2>
      <p class="testo">Lascia i tuoi dati: ti richiamiamo noi per confermare giorni e orari.</p>
      <form class="modulo" method="post" action="/tutor/<%= t.id %>/richiesta">
        <% if (giorni.length) { %>
          <div>
            <label for="disponibilita_id">Una fascia che ti va bene
              <span class="aiuto">Facoltativo, ma ci fa risparmiare due telefonate.</span>
            </label>
            <select id="disponibilita_id" name="disponibilita_id">
              <option value="">Nessuna in particolare</option>
              <% giorni.forEach(function (g) { %>
                <% g.slots.forEach(function (sl) { %>
                  <option value="<%= sl.id %>"><%= dataIt(g.data) %> · <%= ora(sl.ora_inizio) %>–<%= ora(sl.ora_fine) %></option>
                <% }) %>
              <% }) %>
            </select>
          </div>
        <% } %>
        <div>
          <label for="mansione">Di cosa hai bisogno</label>
          <select id="mansione" name="mansione" required>
            <% MANSIONI.filter(function (m) { return t.mansioni.includes(m.id); }).forEach(function (m) { %>
              <option value="<%= m.id %>" <%- mansionePre === m.id ? 'selected' : '' %>><%= m.label %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label for="genitore_nome">Il tuo nome</label>
          <input id="genitore_nome" name="genitore_nome" type="text" required>
        </div>
        <div>
          <label for="genitore_email">Email</label>
          <input id="genitore_email" name="genitore_email" type="email" required>
        </div>
        <div>
          <label for="genitore_telefono">Telefono</label>
          <input id="genitore_telefono" name="genitore_telefono" type="tel">
        </div>
        <div>
          <label for="quando">Quando ti servirebbe</label>
          <input id="quando" name="quando" type="text" placeholder="Martedì e giovedì pomeriggio">
        </div>
        <div>
          <label for="messaggio">Qualche dettaglio
            <span class="aiuto">Età dei bambini, classe, cosa serve.</span>
          </label>
          <textarea id="messaggio" name="messaggio"></textarea>
        </div>
        <%- include('partials/consenso') %>
        <div><button class="bottone" type="submit">Invia la richiesta</button></div>
      </form>

      <% if (waNumero(cfg.whatsapp)) { %>
        <p style="margin:1rem 0 0">
          <a class="bottone chiaro" target="_blank" rel="noopener"
             href="https://wa.me/<%= waNumero(cfg.whatsapp) %>?text=<%- encodeURIComponent('Ciao! Ho visto ' + t.nome + ' su ' + cfg.nome_sito + ' e vorrei informazioni.') %>">Scrivici su WhatsApp</a>
        </p>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/piede') %>
