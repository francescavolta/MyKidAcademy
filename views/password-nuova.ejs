<%- include('partials/testa') %>

<h1 style="margin-top:2.5rem">Scegli una nuova password</h1>
<form class="modulo" method="post" action="/password/<%= token %>">
  <div>
    <label for="password">Nuova password <span class="aiuto">Almeno 8 caratteri.</span></label>
    <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required>
  </div>
  <div><button class="bottone" type="submit">Salva ed entra</button></div>
</form>

