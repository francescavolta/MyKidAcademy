<% if (referenze.elenco.length) { %>
  <div class="referenze">
    <div class="referenze-testa">
      <h3>Referenze</h3>
      <span class="stelle" aria-label="<%= referenze.media %> stelle su 5"><%= stelline(referenze.media) %></span>
      <span class="data"><%= referenze.media %> su 5 · <%= referenze.elenco.length %> <%= referenze.elenco.length === 1 ? 'referenza' : 'referenze' %></span>
    </div>
    <ul>
      <% referenze.elenco.forEach(function (r) { %>
        <li>
          <span class="stelle" aria-label="<%= r.stelle %> stelle su 5"><%= stelline(r.stelle) %></span>
          <p><%= r.commento %></p>
          <div class="data">
            <%= r.autore || 'Una famiglia' %> · <%= new Date(r.created_at).toLocaleDateString('it-IT', { month: 'long', year: 'numeric' }) %>
          </div>
          <% if (utente && utente.role === 'admin' && gestisci) { %>
            <form method="post" action="/area/coordinamento/referenze/<%= r.id %>/elimina"
                  onsubmit="return confirm('Eliminare questa referenza?')">
              <button class="link-testo" type="submit">Elimina</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>
