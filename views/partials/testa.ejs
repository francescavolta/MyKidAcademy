<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= titolo %> · <%= cfg.nome_sito %></title>
<meta name="description" content="Agenzia di ripetizioni, aiuto compiti, babysitter e aiuto in casa. Scegli la persona giusta e ti richiamiamo noi.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?<%= font.query %>&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
<style>
  :root {
    --carta: <%= percorso.startsWith('/blog') ? cfg.colore_blog_sfondo : cfg.colore_carta %>;
    --barra: <%= cfg.colore_barra %>;
    --velo: <%= cfg.colore_velo %>;
    --rosa: <%= cfg.colore_rosa %>;
    --titolo: <%= cfg.colore_titolo %>;
    --prugna: <%= cfg.colore_prugna %>;
    --prugna-scuro: <%= scurisci(cfg.colore_prugna) %>;
    --inchiostro: <%= cfg.colore_inchiostro %>;
    --grigio: <%= cfg.colore_grigio %>;
    --raggio: <%= RAGGI[cfg.raggio] %>;
    --raggio-piccolo: <%= cfg.raggio === 'netto' ? '3px' : '10px' %>;
    --scala: <%= SCALE[cfg.scala] %>;
    --titoli: <%- font.titoli %>;
    --testo: <%- font.testo %>;
    <% if (cfg.ombre === 'no') { %>--ombra: none;<% } %>
  }
</style>
</head>
<body>
<header class="barra">
  <div class="contenitore">
    <a class="marchio" href="/"><%= cfg.nome_sito %></a>
    <nav>
      <a href="/tutor" <%- percorso.startsWith('/tutor') ? 'aria-current="page"' : '' %>>Le nostre tutor</a>
      <a href="/blog" <%- percorso.startsWith('/blog') ? 'aria-current="page"' : '' %>>Blog</a>
      <% if (!utente) { %>
        <a href="/lavora-con-noi">Lavora con noi</a>
        <a href="/accedi">Accedi</a>
      <% } else { %>
        <a href="/area"><%= utente.role === 'admin' ? 'Coordinamento' : 'La mia pagina' %></a>
        <form method="post" action="/esci"><button class="link-testo" type="submit">Esci</button></form>
      <% } %>
    </nav>
  </div>
</header>
<main class="contenitore">
<% if (avviso) { %>
  <p class="avviso <%= avviso.tipo === 'errore' ? 'avviso--errore' : '' %>"><%= avviso.testo %></p>
<% } %>
