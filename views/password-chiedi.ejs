<%- include('partials/testa') %>

<h1 style="margin-top:2.5rem">Password dimenticata</h1>
<p class="guida">Scrivi l'email con cui ti sei candidata: ti mandiamo un link per scegliere una nuova password. Il link vale due ore.</p>

<form class="modulo" method="post" action="/password">
  <div>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="email" required>
  </div>
  <div><button class="bottone" type="submit">Mandami il link</button></div>
</form>

