<%- include('partials/testa') %>

<p style="margin-top:1.5rem"><a href="/area/coordinamento">← Coordinamento</a></p>
<h1>Immagini</h1>
<p class="guida">Carica le foto come sono, anche quelle grandi del telefono: le rimpicciolisco io nel browser prima di spedirle (lato lungo 1800 pixel), così restano leggere nel database. Le GIF animate le lascio intatte.</p>

<form class="modulo" id="form-immagine" method="post" action="/area/coordinamento/immagini" enctype="multipart/form-data">
  <div>
    <label for="file">Scegli l'immagine <span class="aiuto">JPG, PNG, WEBP o GIF.</span></label>
    <input id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" required>
  </div>
  <div>
    <label for="nome">Come la chiami <span class="aiuto">Serve solo a te per ritrovarla.</span></label>
    <input id="nome" name="nome" type="text" maxlength="120" placeholder="bambini che studiano">
  </div>
  <div class="riga-azioni">
    <button class="bottone" type="submit">Carica</button>
    <span id="stato-caricamento" class="data" aria-live="polite"></span>
  </div>
</form>

<script src="/carica-immagine.js" defer></script>

<% if (immagini.length === 0) { %>
  <div class="vuoto" style="margin-top:1.5rem"><p>Nessuna immagine caricata. La prima può essere la copertina del primo articolo.</p></div>
<% } else { %>
  <p class="data" style="margin-top:2rem"><%= immagini.length %> immagini · <%= (totale / 1048576).toFixed(1) %> MB occupati nel database</p>
  <ul class="libreria">
    <% immagini.forEach(function (i) { %>
      <li>
        <img src="/immagini/<%= i.id %>" alt="<%= i.nome %>" loading="lazy">
        <p class="nome"><%= i.nome %></p>
        <p class="data">Per metterla in un articolo: <code>[img:<%= i.id %>]</code></p>
        <form method="post" action="/area/coordinamento/immagini/<%= i.id %>/elimina"
              onsubmit="return confirm('Eliminare questa immagine? Sparisce da dove l\'hai messa.')">
          <button class="link-testo" type="submit">Elimina</button>
        </form>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/piede') %>
