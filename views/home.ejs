<%- include('partials/testa') %>

<% var stile = cfg.home_immagine ? cfg.home_immagine_stile : 'niente'; %>

<section class="hero hero--<%= stile %> hero--h-<%= cfg.home_immagine_altezza %> all--<%= cfg.home_allineamento %>">
  <% if (stile === 'sfondo') { %>
    <div class="hero-sfondo" style="background-image:url('/immagini/<%= cfg.home_immagine %>')">
      <div class="hero-sopra">
        <h1><%- aCapo(cfg.titolo_home) %></h1>
        <p class="guida"><%= cfg.sottotitolo_home %></p>
      </div>
    </div>
  <% } else { %>
    <div class="hero-testo">
      <h1><%- aCapo(cfg.titolo_home) %></h1>
      <p class="guida"><%= cfg.sottotitolo_home %></p>
    </div>
    <% if (stile === 'accanto') { %>
      <img class="hero-foto" src="/immagini/<%= cfg.home_immagine %>" alt="">
    <% } %>
  <% } %>

  <% if (stile === 'sotto') { %>
    <img class="hero-larga" src="/immagini/<%= cfg.home_immagine %>" alt="">
  <% } %>

</section>

<% gruppi.forEach(function (g) { %>
  <section class="fila" style="grid-template-columns: repeat(<%= g.totale %>, minmax(0, 1fr))">
    <% g.blocchi.forEach(function (b, i) { %>
      <div class="cella vert--<%= b.vert %>" style="grid-column: span <%= g.colonne[i] %>">
        <%- include('partials/sezione', { s: b }) %>
      </div>
    <% }) %>
  </section>
<% }) %>

<%- include('partials/piede') %>
