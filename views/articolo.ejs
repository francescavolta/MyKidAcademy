<%- include('partials/testa') %>

<p style="margin-top:1.5rem"><a href="/blog">← Tutti gli articoli</a></p>
<article class="testo-lungo">
  <h1><%= a.titolo %></h1>
  <% if (cfg.blog_data === 'si') { %>
    <div class="data"><%= new Date(a.created_at).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }) %></div>
  <% } %>
  <% if (!a.pubblicato) { %><p class="avviso avviso--errore">Questa è una bozza: la vedi solo tu perché sei nel coordinamento.</p><% } %>
  <% if (a.immagine_id) { %>
    <img class="copertina <%= cfg.blog_copertina_grande === 'si' ? '' : 'copertina--piccola' %>" src="/immagini/<%= a.immagine_id %>" alt="">
  <% } %>
  <% if (a.sommario) { %><p style="font-size:1.1rem;color:var(--grigio)"><%= a.sommario %></p><% } %>
  <%- corpoHtml(a.corpo) %>
</article>

<%- include('partials/piede') %>
